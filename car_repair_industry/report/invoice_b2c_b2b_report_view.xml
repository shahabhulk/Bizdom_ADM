                <div class="page" style="padding: 5px;">
                    <div class="b2b-box">
                        <!-- Invoice Title -->
                        <div class="b2b-title">
                            Tax Invoice(B2B)
                        </div>

                        <!-- Top Header Section Grid -->
                        <table class="b2b-table">
                            <tr>
                                <!-- Left Column: Company & Customer Info -->
                                <td rowspan="7" style="width: 50%; vertical-align: top; border-bottom: 1px solid #000;">
                                    <div class="bold" style="font-size: 14px;"><span t-field="o.company_id.name"/></div>
                                    <div><span t-field="o.company_id.street"/> <span t-field="o.company_id.street2"/></div>
                                    <div><span t-field="o.company_id.city"/></div>
                                    <div t-if="o.company_id.vat">GSTIN/UIN <span t-field="o.company_id.vat"/></div>
                                    <div>
                                        State Name : <span t-field="o.company_id.state_id.name"/>
                                        <t t-if="o.company_id.state_id.code">, Code : <span t-field="o.company_id.state_id.code"/></t>
                                    </div>
                                    <div t-if="o.company_id.email">E-Mail : <span t-field="o.company_id.email"/></div>
                                    <br/>

                                    <div>Consignee (Ship to)</div>
                                    <div class="bold"><span t-field="o.partner_id.name"/></div>
                                    <div t-if="o.partner_id.street"><span t-field="o.partner_id.street"/> <span t-field="o.partner_id.city"/></div>
                                    <div t-if="o.partner_id.vat">GSTIN/UIN : <span class="bold" t-field="o.partner_id.vat"/></div>
                                    <div>
                                        State Name : <span t-field="o.partner_id.state_id.name"/>
                                        <t t-if="o.partner_id.state_id.code">, Code : <span t-field="o.partner_id.state_id.code"/></t>
                                    </div>
                                    <br/>

                                    <div>Buyer (Bill to)</div>
                                    <div class="bold"><span t-field="o.partner_id.name"/></div>
                                    <div t-if="o.partner_id.street"><span t-field="o.partner_id.street"/> <span t-field="o.partner_id.city"/></div>
                                    <div t-if="o.partner_id.vat">GSTIN/UIN : <span class="bold" t-field="o.partner_id.vat"/></div>
                                    <div>
                                        State Name : <span t-field="o.partner_id.state_id.name"/>
                                        <t t-if="o.partner_id.state_id.code">, Code : <span t-field="o.partner_id.state_id.code"/></t>
                                    </div>
                                </td>

                                <td style="width: 25%;">
                                    Invoice No.<br/>
                                    <span class="bold" t-field="o.name"/>
                                </td>
                                <td style="width: 25%;">
                                    Dated<br/>
                                    <span class="bold" t-field="o.invoice_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Delivery Note<br/>
                                    <span t-field="o.ref"/>
                                </td>
                                <td>
                                    Mode/Terms of Payment<br/>
                                    <span t-field="o.invoice_payment_term_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Reference No. &amp; Date<br/>
                                </td>
                                <td>
                                    Other References<br/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Buyer's Order No.<br/>
                                    <span t-field="o.invoice_origin"/>
                                </td>
                                <td>
                                    Dated<br/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Dispatch Doc No.<br/>
                                </td>
                                <td>
                                    Delivery Note Date<br/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    Dispatched through<br/>
                                </td>
                                <td>
                                    Destination<br/>
                                </td>
                            </tr>
