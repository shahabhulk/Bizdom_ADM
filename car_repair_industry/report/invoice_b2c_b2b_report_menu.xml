<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_b2c_invoice" model="report.paperformat">
            <field name="name">B2C Invoice A4</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">5</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_invoice_b2c" model="ir.actions.report">
            <field name="name">B2C Invoice</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">car_repair_industry.report_invoice_b2c_template</field>
            <field name="report_file">car_repair_industry.report_invoice_b2c_template</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="car_repair_industry.paperformat_b2c_invoice"/>
        </record>

        <record id="action_report_invoice_b2b" model="ir.actions.report">
            <field name="name">B2B Invoice</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">car_repair_industry.report_invoice_b2b_template</field>
            <field name="report_file">car_repair_industry.report_invoice_b2b_template</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="car_repair_industry.paperformat_b2c_invoice"/>
        </record>
    </data>
</odoo>
