<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Timeline History List View -->
    <record id="view_employee_timeline_history_list" model="ir.ui.view">
        <field name="name">employee.timeline.history.list</field>
        <field name="model">employee.timeline.history</field>
        <field name="arch" type="xml">
            <list string="Employee Timeline History" create="0">
                <field name="employee_id"/>
                <field name="status" column_invisible="1"/>
                <field name="job_status" column_invisible="1"/>
                <field name="display_status" string="Status" widget="badge" 
                       decoration-success="display_status in ('Working', 'Completed')"
                       decoration-info="display_status == 'Assigned'"
                       decoration-danger="display_status == 'Idle' and idle_reason_display in ('—', False, '', 'Idle')"
                       decoration-muted="display_status == 'Idle' and idle_reason_display not in ('—', False, '', 'Idle')"/>
                <field name="pause_reason_display" string="Pause Reason" widget="badge" 
                       decoration-success="pause_reason_display in ('🔧 Working', '✅ Completed')"
                       decoration-warning="pause_reason_display not in ('—', False, '🔧 Working', '✅ Completed')"/>
                <field name="idle_reason_display" string="Idle Reason" optional="show" widget="badge"
                       decoration-danger="idle_reason_display == 'Idle'"
                       decoration-info="idle_reason_display not in ('—', False, 'Idle')"/>
                <field name="job_id" string="Job Card"/>
                <field name="license_plate" string="License Plate"/>
                <field name="fleet_id" string="Car"/>
                <field name="model_name" string="Model"/>
                <field name="start_datetime" string="Start Time"/>
                <field name="end_datetime" string="End Time"/>
                <field name="duration_display" string="Duration" optional="show"/>
                <field name="worked_time_display" string="Worked Time"/>
                <field name="pause_time_display" string="Pause Time"/>
                <field name="total_elapsed_display" string="Total Elapsed"/>
                <field name="notes" string="Notes" optional="hide"/>
                <button name="action_open_repair_order" type="object" icon="fa-external-link" title="Open Job Card" invisible="not job_id" class="btn btn-sm btn-link"/>
            </list>
        </field>
    </record>

    <!-- Employee Timeline History Form View -->
    <record id="view_employee_timeline_history_form" model="ir.ui.view">
        <field name="name">employee.timeline.history.form</field>
        <field name="model">employee.timeline.history</field>
        <field name="arch" type="xml">
            <form string="Employee Activity Detail" create="0" edit="0">
                <header>
                    <button name="action_open_repair_order" string="Open Job Card" type="object" class="btn btn-outline-primary" invisible="not job_id" icon="fa-external-link"/>
                    <field name="job_status" widget="statusbar" statusbar_visible="assigned,working,paused,completed" invisible="not job_id"/>
                </header>
                <sheet>
                    <field name="has_paused_services" invisible="1"/>
                    <field name="pause_reason" invisible="1"/>
                    <field name="pause_notes" invisible="1"/>

                    <!-- Service Tasks Section -->
                    <div class="mb-4" invisible="not job_id">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold text-dark fs-6 text-uppercase">
                                    SERVICE TASKS
                                </span>
                                <i class="fa fa-arrow-right text-muted small" style="font-size: 11px;"/>
                                <span class="badge rounded-pill px-3 py-1" style="background-color: #10B981; color: white;" invisible="not is_collective_timer_running">
                                    <i class="fa fa-clock-o fa-spin me-1"/>Stopwatch
                                </span>
                                <span class="badge rounded-pill px-3 py-1" style="background-color: #EF4444; color: white;" invisible="is_collective_timer_running or job_status != 'paused' or pause_reason">
                                    <i class="fa fa-pause me-1"/>Stop
                                </span>
                                <span class="badge rounded-pill px-3 py-1" style="background-color: #F59E0B; color: #000;" invisible="is_collective_timer_running or job_status != 'paused' or pause_reason != 'waiting_parts'">
                                    <i class="fa fa-pause me-1"/>Waiting for Parts
                                </span>
                                <span class="badge rounded-pill px-3 py-1" style="background-color: #2563EB; color: #fff;" invisible="is_collective_timer_running or job_status != 'paused' or pause_reason != 'waiting_approval'">
                                    <i class="fa fa-pause me-1"/>Waiting for Approval
                                </span>
                                <span class="badge rounded-pill px-3 py-1" style="background-color: #9333EA; color: #fff;" invisible="is_collective_timer_running or job_status != 'paused' or pause_reason != 'waiting_qc'">
                                    <i class="fa fa-pause me-1"/>Waiting for QC
                                </span>
                                <span class="badge rounded-pill px-3 py-1" style="background-color: #EA580C; color: #fff;" invisible="is_collective_timer_running or job_status != 'paused' or pause_reason != 'assistance_required'">
                                    <i class="fa fa-pause me-1"/>Assistance Required
                                </span>
                                <span class="badge rounded-pill px-3 py-1" style="background-color: #D97706; color: #fff;" invisible="is_collective_timer_running or job_status != 'paused' or pause_reason != 'tools_issue'">
                                    <i class="fa fa-pause me-1"/>Tool / Equipment Unavailable
                                </span>
                                <span class="badge rounded-pill px-3 py-1" style="background-color: #64748B; color: #fff;" invisible="is_collective_timer_running or job_status != 'paused' or pause_reason != 'other'">
                                    <i class="fa fa-pause me-1"/>Other
                                </span>
                                <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded bg-warning-subtle border border-warning text-dark font-monospace fs-6 fw-bold shadow-sm" invisible="not has_paused_services and not is_pause_running and pause_duration == 0 and job_status != 'paused'" title="Pause Timer running against reason">
                                    <i class="fa fa-clock-o text-warning"/>
                                    <span>Pause: </span>
                                    <field name="pause_duration" widget="pause_live_timer" readonly="1" nolabel="1"/>
                                </span>
                                <span class="text-muted small ms-1" invisible="not has_paused_services and not is_pause_running and pause_duration == 0 and job_status != 'paused'">
                                    Worked:
                                </span>
                                <field name="collective_duration" widget="collective_live_timer" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                        <field name="service_line_ids" readonly="1">
                            <list>
                                <field name="item_code" string="Item Code" optional="show"/>
                                <field name="product_id" string="Service"/>
                                <field name="department_id" string="Department" optional="show"/>
                                <field name="employee_id" string="Assigned Technician"/>
                                <field name="timer_start" string="Start Date" optional="show"/>
                                <field name="timer_end" string="End Date" optional="show"/>
                                <field name="hours" string="Worked Hrs" optional="show" sum="Total"/>
                                <field name="alloted_fru" string="FRU" optional="hide"/>
                                <field name="time_diff" string="Duration" widget="stopwatch_timer" readonly="1" optional="hide"/>
                                <field name="line_status" string="Status" widget="badge" optional="show"
                                       decoration-success="line_status in ('completed', 'working')"
                                       decoration-danger="line_status == 'paused'"
                                       decoration-muted="line_status == 'assigned'"/>
                            </list>
                        </field>
                    </div>

                    <!-- Job and Car Details -->
                    <group>
                        <group string="Status Information">
                            <field name="employee_id" readonly="1"/>
                            <field name="department_id" invisible="1"/>
                            <field name="status" readonly="1"/>
                            <field name="pause_reason_display" string="Pause Reason" invisible="not has_paused_services and job_status != 'paused'"/>
                            <field name="pause_duration" string="Pause Time" widget="pause_live_timer" invisible="not has_paused_services and not is_pause_running and pause_duration == 0 and job_status != 'paused'" readonly="1"/>
                            <field name="worked_hours" widget="stopwatch_live_timer" readonly="1"/>
                            <field name="start_datetime" readonly="1"/>
                            <field name="end_datetime" readonly="1"/>
                        </group>
                        <group string="Job Card">
                            <field name="job_id" string="Job Card No" readonly="1"/>
                            <field name="duration" invisible="1"/>
                            <field name="service_line_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Car Details" invisible="not job_id">
                        <group>
                            <field name="license_plate" readonly="1"/>
                            <field name="fleet_id" string="Car" readonly="1"/>
                            <field name="model_name" string="Model" readonly="1"/>
                        </group>
                        <group>
                            <field name="vin_sn" string="Chassis Number" readonly="1"/>
                            <field name="kilometers_num" string="KMS" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Optional notes or downtime reason..." readonly="1"/>
                    </group>
                    <!-- Invisible dependencies -->
                    <field name="is_timer_running" invisible="1"/>
                    <field name="is_timer_paused" invisible="1"/>
                    <field name="timer_start" invisible="1"/>
                    <field name="timer_last_start" invisible="1"/>
                    <field name="timer_end" invisible="1"/>
                    <field name="product_id" invisible="1"/>
                    <field name="time_diff" invisible="1"/>
                    <field name="alloted_fru" invisible="1"/>
                    <field name="is_collective_timer_running" invisible="1"/>
                    <field name="collective_selected_count" invisible="1"/>
                    <field name="collective_timer_last_start" invisible="1"/>
                    <field name="collective_accumulated_seconds" invisible="1"/>
                    <field name="collective_target_hours" invisible="1"/>
                    <field name="collective_target_seconds" invisible="1"/>
                    <field name="collective_remaining_seconds" invisible="1"/>
                    <field name="timer_mode" invisible="1"/>
                    <field name="is_pause_running" invisible="1"/>
                    <field name="pause_timer_start" invisible="1"/>
                    <field name="pause_accumulated_seconds" invisible="1"/>
                    <field name="pause_time_display" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Employee Timeline History Search View -->
    <record id="view_employee_timeline_history_search" model="ir.ui.view">
        <field name="name">employee.timeline.history.search</field>
        <field name="model">employee.timeline.history</field>
        <field name="arch" type="xml">
            <search string="Search Timeline History">
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="license_plate"/>
                <field name="fleet_id"/>
                <field name="model_name"/>
                <field name="service_name"/>
                <filter string="Ongoing Activities" name="filter_ongoing" domain="[('end_datetime', '=', False)]"/>
                <filter string="Finished Activities" name="filter_finished" domain="[('end_datetime', '!=', False)]"/>
                <separator/>
                <filter string="Idle" name="filter_idle" domain="['|', ('status', '=', 'idle'), ('job_status', '=', 'idle')]"/>
                <filter string="Completed" name="filter_completed" domain="['|', ('status', '=', 'completed'), ('job_status', '=', 'completed')]"/>
                <separator/>
                <filter string="Today" name="filter_today" domain="[('start_datetime', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Job Card" name="group_job" context="{'group_by': 'job_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'display_status'}"/>
                    <filter string="Pause Reason" name="group_pause_reason" context="{'group_by': 'pause_reason'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'start_datetime:day'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'start_datetime:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Employee Timeline History Pivot View -->
    <record id="view_employee_timeline_history_pivot" model="ir.ui.view">
        <field name="name">employee.timeline.history.pivot</field>
        <field name="model">employee.timeline.history</field>
        <field name="arch" type="xml">
            <pivot string="Employee Activity Analysis" sample="1">
                <field name="employee_id" type="row"/>
                <field name="display_status" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Employee Timeline History Graph View -->
    <record id="view_employee_timeline_history_graph" model="ir.ui.view">
        <field name="name">employee.timeline.history.graph</field>
        <field name="model">employee.timeline.history</field>
        <field name="arch" type="xml">
            <graph string="Activity Duration Analysis" type="bar" sample="1">
                <field name="employee_id"/>
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Window Action for Employee Timeline History -->
    <record id="action_employee_timeline_history" model="ir.actions.act_window">
        <field name="name">Employee Timeline History</field>
        <field name="res_model">employee.timeline.history</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">['|', ('status', 'in', ['idle', 'completed']), ('job_status', 'in', ['idle', 'completed'])]</field>
        <field name="search_view_id" ref="view_employee_timeline_history_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_employee_timeline_history_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_employee_timeline_history_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No timeline records found.
            </p>
            <p>
                Each and every activity of employees (working, pausing, resuming, idle, completions) is recorded here as per the timeline.
            </p>
        </field>
    </record>

    <!-- Top Menu Item in Car Repair -->
    <menuitem id="menu_employee_timeline_history"
              name="Timeline History"
              parent="car_repair_industry.menu_main_car_repair"
              action="action_employee_timeline_history"
              sequence="17"
              groups="car_repair_industry.group_fleet_repair_head_technician,car_repair_industry.group_fleet_repair_service_manager,car_repair_industry.group_fleet_repair_directeur_commercial"/>
</odoo>
