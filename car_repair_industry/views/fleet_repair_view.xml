<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--fleet Repair Form View-->
        <record id="view_fleet_repair_form" model="ir.ui.view">
            <field name="name">fleet.repair.form</field>
            <field name="model">fleet.repair</field>
            <field name="arch" type="xml">
                <form string="Car Repair">
                    <header>
                        <button name="action_create_quotation_fleet" type="object" string="Create Quotation"
                                class="btn-primary"/>
                        <button name="action_create_invoice_fleet" type="object" string="Create Invoice"
                                class="btn-primary"/>
                        <button name="action_recompute_all_parts_costs" type="object" string="Recalculate Purchase Costs"
                                class="btn-secondary"/>
                        <!--                        <button name="%(sale.action_orders)d" type="action" string="Quotation" class="oe_stat_button"-->
                        <!--                                icon="fa-file-text-o">-->
                        <!--                            <field name="sale_order_id" widget="statinfo"/>-->
                        <!--                        </button>-->
                        <!--                        <button name="action_create_fleet_diagnosis" string="Create Car Diagnosis"-->
                        <!--                                invisible="state != 'draft'" type="object" class="oe_highlight" style="float:left;"-->
                        <!--                                groups="car_repair_industry.group_fleet_repair_service_manager,car_repair_industry.group_fleet_repair_directeur_commercial,car_repair_industry.group_fleet_repair_head_technician"/>-->
                        <button name="action_print_receipt" string="Print Receipt" invisible="state != 'draft'"
                                type="object" style="float:left;"/>
                        <button name="action_print_label" string="Print Label" invisible="state != 'draft'"
                                type="object" style="float:left;"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,diagnosis,quote,saleorder,workorder,done"
                               options="{'clickable': '1'}"/>
                    </header>
                    <sheet string="Car Repair">


                        <div class="oe_button_box" name="button_box">
                            <button type="object"
                                    name="button_view_workorder"
                                    class="oe_stat_button"
                                    icon="fa-wrench"
                                    invisible="workorder_count == 0" groups="base.group_user">
                                <field name="workorder_count" widget="statinfo" string="Work Order"/>
                            </button>


                            <!--                            <button type="object"-->
                            <!--                                    name="button_view_diagnosis"-->
                            <!--                                    class="oe_stat_button"-->
                            <!--                                    icon="fa-pencil-square"-->
                            <!--                                    invisible="dig_count == 0" groups="base.group_user">-->
                            <!--                                <field name="dig_count" widget="statinfo" string="Diagnoses"/>-->
                            <!--                            </button>-->

                            <button type="object"
                                    name="button_view_quotation_fleet"
                                    class="oe_stat_button"
                                    icon="fa-usd"
                                    invisible="quotation_count == 0" groups="base.group_user">
                                <field name="quotation_count" widget="statinfo" string="Quotations"/>
                            </button>


                            <button type="object"
                                    name="button_view_invoice_fleet"
                                    class="oe_stat_button"
                                    icon="fa-pencil-square-o"
                                    string="Invoices"
                                    invisible="inv_count == 0" groups="base.group_user">
                                <field name="inv_count" widget="statinfo" string="Invoices"/>
                            </button>


                            <button type="object"
                                    name="button_view_saleorder"
                                    class="oe_stat_button"
                                    icon="fa-usd"
                                    invisible="saleorder_count == 0" groups="base.group_user">
                                <field name="saleorder_count" widget="statinfo" string="Sales Orders"/>
                            </button>


                            <!--                            <button type="object"-->
                            <!--                                    name="button_view_invoice_fleet"-->
                            <!--                                    class="oe_stat_button"-->
                            <!--                                    icon="fa-pencil-square-o"-->
                            <!--                                    invisible="inv_count == 0" groups="base.group_user">-->
                            <!--                                <field name="inv_count" widget="statinfo" string="Invoices"/>-->
                            <!--                            </button>-->
                        </div>

                        <div class="oe_title oe_left">
                            <h1>
                                <field name="job_card_display"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <!--                                <field name="name" readonly="state != 'draft'"/>-->
                                <field name="user_id" readonly="state != 'draft'" required="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="confirm_sale_order" invisible="True"/>

                            </group>
                            <group>
                                <field name="priority" widget="priority" readonly="state != 'draft'"/>
                                <field name="receipt_date" readonly="1"/>
                                <field name="promised_date" required="1"/>
                                <field name="images_ids" widget='many2many_binary'/>
                                <field name="sale_order_id" invisible="True"/>
                                <field name="workorder_id" invisible="True"/>
                                <field name="diagnose_id" readonly="True" invisible="True"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="General">
                                <group string="Car Info">
                                    <group>
                                        <field name="license_plate" required="1" context="{'default_model_id': model_name, 'default_vin_sn': vin_sn, 'default_driver_id': client_id, 'default_odometer': kilometers_num}"/>
                                        <field name="fleet_id" string="Car" required="1" readonly="1" force_save="1"/>
                                    </group>
                                    <group>
                                        <field name="model_name" required="1" readonly="1" force_save="1"/>
                                        <field name="vin_sn" required="1"/>
                                        <field name="kilometers_num" string="KMS" required="1"/>
                                    </group>
                                </group>
                                <separator string="Client Info"/>
                                <group>
                                    <group>
                                         <field name="client_id" options='{"no_quick_create": True}' readonly="state != 'draft'"
                                                string="Client" required="1"/>
                                         <field name="client_address" string="Address" readonly="state != 'draft'"/>
                                         <field name="contact_name" string="Driver"/>
                                    </group>
                                    <group>
                                        <field string="Mobile 1" name="client_phone" readonly="state != 'draft'" required="1"/>
                                        <field string="Mobile 2" name="client_mobile" readonly="state != 'draft'"/>
                                        <field name="client_email" string="Email" widget="email" readonly="state != 'draft'" required="1"/>
                                    </group>
                                </group>

                                <!--                                <separator string="Car Info"/>-->
                                <!--                                <field name="fleet_repair_line" readonly="state != 'draft'" widget="one2many_list"/>-->
                                <separator string="Repair Details"/>
                                <field name="service_detail_line" readonly="state != 'draft'" widget="one2many_list">
                                    <list editable="bottom">
                                        <field name="service_type" string="Repair Details"/>
                                        <field name="department_id" string="Department" options="{'no_create': True, 'no_create_edit': True}"/>
                                    </list>
                                </field>
                                <separator string="Parts"/>
                                <field name="product_line_ids" readonly="state in ('done', 'cancel')" widget="one2many_list" context="{'default_repair_id': id}">
                                    <list editable="bottom">
                                        <field name="item_code_id" column_invisible="1"/>
                                        <field name="item_code_display" widget="item_code_autocomplete" string="Item Code" optional="hide"
                                               readonly="parent.state in ('done', 'cancel', 'invoiced')"/>
                                        <field name="product_id" options="{'no_quick_create': True}" context="{'default_categ_id': False}"
                                               readonly="parent.state in ('done', 'cancel', 'invoiced')"/>
                                        <field name="department_id" required="1" optional="show" options="{'no_create': True, 'no_create_edit': True}"
                                               readonly="parent.state in ('done', 'cancel', 'invoiced')"/>
                                        <field name="quantity"
                                               readonly="parent.state in ('done', 'cancel', 'invoiced')"/>
                                        <field name="uom_id"
                                               readonly="parent.state in ('done', 'cancel', 'invoiced')"/>
                                        <field name="qty_issued" readonly="1" optional="hide"/>
                                        <field name="qty_to_return" column_invisible="1"/>
                                        <field name="onhand_qty" readonly="1" optional="hide" string="Physical Stock"/>
                                        <field name="available_qty" readonly="1" optional="show" string="Available Stock"/>
                                        <field name="can_issue" column_invisible="1"/>
                                        <field name="can_return" column_invisible="1"/>
                                        <button name="action_issue_part" type="object" string="Issue"
                                                class="btn-link" icon="fa-arrow-right"
                                                column_invisible="1"/>
                                        <button name="action_return_part" type="object" string="Return"
                                                class="btn-link" icon="fa-undo"
                                                column_invisible="1"/>
                                        <field name="unit_price" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"
                                               readonly="parent.state in ('done', 'cancel', 'invoiced')"/>
                                        <field name="vendor_cost_summary" readonly="1" optional="hide"/>
                                        <field name="issue_cost_line_ids" readonly="1" optional="hide">
                                            <list create="0" edit="0" delete="0">
                                                <field name="vendor_name"/>
                                                <field name="quantity"/>
                                                <field name="unit_cost" widget="monetary"
                                                       options="{'currency_field': 'currency_id'}"/>
                                                <field name="cost_subtotal" widget="monetary"
                                                       options="{'currency_field': 'currency_id'}"/>
                                                <field name="issue_date" optional="show"/>
                                                <field name="currency_id" column_invisible="1"/>
                                            </list>
                                        </field>
                                        <field name="cost_price" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"
                                               readonly="1" optional="hide"/>
                                        <field name="cost_subtotal" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"
                                               readonly="1" optional="hide"/>
                                        <field name="margin" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"
                                               readonly="1" optional="hide"/>
                                        <field name="margin_percent" readonly="1" optional="hide"/>
                                        <field name="subtotal" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                                <separator string="Service"/>
                                <field name="service_line_ids" readonly="state in ('done', 'cancel')" widget="one2many_list" context="{'default_repair_id': id}">
                                    <list editable="bottom">
                                        <field name="fru_status" column_invisible="1"/>
                                        <field name="item_code_id" column_invisible="1"/>
                                        <field name="item_code" widget="item_code_autocomplete" options="{'product_type': 'service'}" string="Item Code" optional="show"
                                               readonly="parent.state in ('done', 'cancel', 'invoiced')"/>
                                        <field name="product_id" string="Service" domain="[('type', '=', 'service')]" context="{'default_type': 'service', 'default_categ_id': False}" options="{'no_quick_create': True}"
                                               readonly="parent.state in ('done', 'cancel', 'invoiced')"/>
                                        <field name="department_id" required="1" optional="hide" options="{'no_create': True, 'no_create_edit': True}"
                                               readonly="parent.state in ('done', 'cancel', 'invoiced')"/>
                                        <field name="employee_id" required="1" optional="show" options="{'no_create': True, 'no_create_edit': True}"
                                               readonly="parent.state in ('done', 'cancel', 'invoiced')"/>
                                        <field name="timer_start" string="Start Date" readonly="1"/>
                                        <field name="timer_end" string="End Date" readonly="1"/>
                                        <field name="is_timer_running" column_invisible="1"/>
                                        <field name="timer_last_start" column_invisible="1"/>
                                        <field name="accumulated_seconds" column_invisible="1"/>
                                        <field name="time_diff" string="Duration" widget="stopwatch_timer" sum="Total"
                                               decoration-success="fru_status == 'green'"
                                               decoration-warning="fru_status == 'yellow'"
                                               decoration-danger="fru_status == 'red'"/>
                                        <field name="is_timer_paused" string="Reset" widget="reset_timer_button" optional="hide"/>
                                        <field name="alloted_fru" string="FRU"
                                               readonly="parent.state in ('done', 'cancel', 'invoiced')"/>
                                        <field name="quantity" column_invisible="1"/>
                                        <field name="uom_id" column_invisible="1"/>
                                        <field name="unit_price" string="Price" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"
                                               readonly="parent.state in ('done', 'cancel', 'invoiced') or alloted_fru > 0"
                                               force_save="1"/>
                                        <field name="subtotal" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                                <div class="mt-2 d-flex justify-content-end">
                                    <table class="table table-sm mb-0 w-auto">
                                        <tr>
                                            <td class="text-end">
                                                <strong>Parts Total:</strong>
                                            </td>
                                            <td class="text-end pe-3">
                                                <field name="currency_id" invisible="1"/>
                                                <field name="amount_parts" widget="monetary" readonly="1"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-end">
                                                <strong>Service Total:</strong>
                                            </td>
                                            <td class="text-end pe-3">
                                                <field name="amount_service" widget="monetary" readonly="1"/>
                                            </td>
                                        </tr>
                                        <tr class="border-top fw-bold">
                                            <td class="text-end">
                                                <strong>Total:</strong>
                                            </td>
                                            <td class="text-end pe-3">
                                                <field name="amount_total" widget="monetary" readonly="1"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </page>
                            <page name="Notes" string="Notes">
                                <group>
                                    <field name="client_description"/>
<!--                                    <field name="csat_rating" widget="priority"/>-->
                                </group>
                            </page>
                            <page name="checklist" string="Service Repair Checklist">
                                <group>
                                    <field name="repair_checklist_ids" colspan="2" nolabel="1"
                                           options="{'no_create': True}">
                                    </field>
                                </group>
                            </page>

                            <page string="Car works">
                                <field name="fleet_work_line_ids" widget="one2many_list">
                                    <list editable="bottom">
                                        <field name="repair_id" column_invisible="1"/>
                                        <field name="work_type" domain="[('type', '=', 'service')]" options="{'no_create': True, 'no_create_edit': True}"/>
                                        <field name="employee_id" domain="['|', ('department_id', '=', department_type_id), ('department_id', '=', False)]" options="{'no_create': True, 'no_create_edit': True}"/>
                                        <field name="department_type_id" string="Department" optional="hide" options="{'no_create': True, 'no_create_edit': True}"/>
                                        <field name="timer_start" string="Start Date" readonly="1"/>
                                        <field name="timer_end" string="End Date" readonly="1"/>
                                        <field name="is_timer_running" column_invisible="1"/>
                                        <field name="timer_last_start" column_invisible="1"/>
                                        <field name="accumulated_seconds" column_invisible="1"/>
                                        <field name="time_diff" string="Duration" widget="stopwatch_timer" sum="Total"/>
                                        <field name="is_timer_paused" string="Reset" widget="reset_timer_button" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!--fleet Repair Tree View-->

        <record id="view_fleet_repair_tree" model="ir.ui.view">
            <field name="name">fleet.repair.list</field>
            <field name="model">fleet.repair</field>
            <field name="priority">4</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" string="Number"/>
                    <field name="client_id"/>
                    <field name="client_phone"/>
                    <field name="receipt_date" options="{'show_time': false}" width="120px"/>
                    <field name="user_id" optional="hide"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="amount_parts" string="Parts Total" widget="monetary" optional="show" readonly="1"/>
                    <field name="amount_service" string="Service Total" widget="monetary" optional="show" readonly="1"/>
                    <field name="amount_total" string="Total Amount" widget="monetary" readonly="1"/>
                    <field name="invoice_paid_amount" string="Paid Amount" widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                    <field name="wip_fru_status" column_invisible="1"/>
                    <field name="total_service_fru" column_invisible="1"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'done' or (state == 'workorder' and wip_fru_status == 'green')"
                           decoration-warning="state == 'workorder' and wip_fru_status == 'yellow'"
                           decoration-danger="state == 'workorder' and wip_fru_status == 'red'"/>
                    <field name="service_employee_id" widget="many2one_avatar_employee" string="Employee" optional="show"/>
                    <field name="active_service_time_diff" widget="active_service_timer" string="Active Timer" optional="show"/>
                    <field name="promised_date" widget="remaining_days" invisible="state == 'done'"/>
                    <field name="delivery_status_color" widget="delivery_status" string="Signal"/>
<!--                    <field name="csat_rating" widget="priority"/>-->
                </list>
            </field>
        </record>


        <record id="view_repair_order_filter" model="ir.ui.view">
            <field name="name">fleet.repair.list.select</field>
            <field name="model">fleet.repair</field>
            <field name="arch" type="xml">
                <search string="Search Repair Order">
                    <field name="sequence"/>
                    <field name="name" string="Repair Order"/>
                    <field name="client_id" operator="child_of"/>
                    <field name="user_id"/>
                    <field name="fleet_id"/>
                    <field name="service_employee_id" string="Employee"/>
                    <separator/>
                    <filter string="Active Work" name="active_work" domain="[('has_active_service_timer', '=', True)]"/>
                    <filter string="Not Done" name="not_done" domain="[('state', '!=', 'done')]"/>
                    <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Employee" name="group_service_employee" context="{'group_by': 'service_employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!--Action-->
        <record model="ir.actions.act_window" id="action_fleet_repair_tree_view">
            <field name="name">Car Repair</field>
            <field name="res_model">fleet.repair</field>
            <field name="domain">[('state', '!=', 'done')]</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_repair_order_filter"/>
            <field name="view_id" ref="view_fleet_repair_tree"/>
        </record>

        <!--Menuitems-->
        <menuitem id="menu_main_car_repair" name="Car Repair" sequence="50"/>
        <menuitem name="Car Repair" parent="menu_main_car_repair" id="menu_sub_car_repair" sequence="3"/>

        <menuitem name="Car Repair" parent="menu_sub_car_repair" id="menu_fleet_repair_submenu" sequence="3"
                  action="action_fleet_repair_tree_view"/>


        <!-- service type -->
        <record id="service_type_form_view" model="ir.ui.view">
            <field name="name">service.type.form.view</field>
            <field name="model">service.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet string="Service Types">
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="department_id" options="{'no_create': True}"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="service_type_tree_view" model="ir.ui.view">
            <field name="name">service.type.list.view</field>
            <field name="model">service.type</field>
            <field name="arch" type="xml">
                <list string="Service Type">
                    <field name="name"/>
                    <field name="department_id" optional="show"/>
                </list>
            </field>
        </record>

        <record id="action_service_type" model="ir.actions.act_window">
            <field name="name">Service Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">service.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Service Type" parent="menu_sub_car_repair" id="menu_service_type" sequence="11"
                  action="action_service_type"/>
        <!-- fleet Lines-->

        <record id="view_repair_fleet_line_form" model="ir.ui.view">
            <field name="name">fleet.repair.line.form</field>
            <field name="model">fleet.repair.line</field>
            <field name="arch" type="xml">
                <form string="fleet Lines">
                    <header>
                        <button name="action_add_fleet_diagnosis_result" string="Enter Results" type="object"
                                class="oe_highlight" style="float:left;"
                                invisible="(diagnose_id == False) or (state in ['done', 'draft'])"
                                groups="car_repair_industry.group_fleet_repair_head_technician,car_repair_industry.group_fleet_repair_directeur_commercial,car_repair_industry.group_fleet_repair_service_manager"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,diagnosis,done"/>
                    </header>
                    <sheet>
                        <group class="col-xs-12">
                            <group class="col-xs-6">
                                <field name="fleet_id"/>
                                <field name="license_plate"/>
                                <field name="vin_sn"/>
                            </group>
                            <group class="col-xs-6">
                                <field name="model_id"/>
                                <field name="fuel_type"/>
                                <field name="car_year"/>
                                <field name="diagnose_id" invisible="True"/>
                                <field name="workorder_id" invisible="True"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Repair Details">
                                <group>
                                    <group>
                                        <field name="guarantee" widget="radio" readonly="state != 'draft'"/>
                                        <field name="guarantee_type" widget="radio" invisible="guarantee == 'no'"
                                               readonly="state != 'draft'"/>
                                    </group>
                                    <group>
                                        <field name="service_type" readonly="state != 'draft'"/>
                                    </group>
                                </group>
                                <separator string="Repair Details"/>
                                <field name="service_detail" readonly="state != 'draft'"/>
                                <separator string="List of Damage"/>
                                <field name="list_of_damage" readonly="state != 'draft'"/>
                            </page>
                            <page string="Diagnosis Report">
                                <group>

                                    <group invisible="guarantee_type == 'free'">
                                        <field name="est_ser_hour" readonly="workorder_id != False"/>
                                    </group>
                                </group>
                                <separator string="Spare Parts / Add Service"/>
                                <field name="spare_part_ids" readonly="workorder_id != False">
                                    <list string="Spare Parts" editable="bottom">
                                        <field name="product_id" domain="[('type', 'in', ['service','consu'])]"/>
                                        <field name="default_code"/>
                                        <field name="quantity"/>
                                        <field name="price_unit"/>
                                    </list>
                                </field>
                                <separator string="Diagnostic Results"/>
                                <field name="diagnostic_result" readonly="workorder_id != False"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_repair_fleet_line_tree" model="ir.ui.view">
            <field name="name">repair.fleet.line.list</field>
            <field name="model">fleet.repair.line</field>
            <field name="priority">4</field>
            <field name="arch" type="xml">
                <list string="fleet Lines">
                    <field name="fleet_id"/>
                    <field name="license_plate"/>
                    <field name="model_id"/>
                    <field name="vin_sn"/>
                    <field name="fuel_type"/>
                    <field name="car_year"/>
                    <field name="guarantee" widget="radio"/>
                    <field name="service_type"/>
                </list>
            </field>
        </record>

        <record id="fleet_vehicle_view_form_inherit_repair" model="ir.ui.view">
            <field name="name">fleet.vehicle.form.inherit.repair</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='driver_id']" position="attributes">
                    <attribute name="required">1</attribute>
                    <attribute name="string">Client</attribute>
                </xpath>
                <xpath expr="//field[@name='driver_id']/parent::group" position="attributes">
                    <attribute name="string">Client</attribute>
                </xpath>
                <xpath expr="//field[@name='vin_sn']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
                <xpath expr="//field[@name='odometer']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
