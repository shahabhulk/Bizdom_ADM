<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="car_repair_industry.ItemCodeAutoCompleteField">
        <div class="o_field_widget o_field_char">
            <t t-if="props.readonly">
                <span t-esc="value"/>
            </t>
            <t t-else="">
                <AutoComplete
                    value="value"
                    sources="sources"
                    placeholder="props.placeholder || ''"
                    onSelect="(option) => this.onSelectOption(option)"
                    onChange="(val) => this.onInputChange(val)"
                />
            </t>
        </div>
    </t>
</templates>
