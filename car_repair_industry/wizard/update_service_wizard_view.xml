<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_update_service_wizard_form" model="ir.ui.view">
        <field name="name">update.service.wizard.form</field>
        <field name="model">update.service.wizard</field>
        <field name="arch" type="xml">
            <form string="Stop Service">
                <sheet>
                    <field name="service_line_id" invisible="1"/>
                    <field name="status_log_id" invisible="1"/>
                    <group>
                        <field name="service_name" readonly="1" string="Service Name"/>
                        <field name="stop_reason_id" string="Stop Reason" required="1" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Stop Service" type="object" class="btn-danger fw-bold"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_update_service_wizard" model="ir.actions.act_window">
        <field name="name">Stop Service</field>
        <field name="res_model">update.service.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
