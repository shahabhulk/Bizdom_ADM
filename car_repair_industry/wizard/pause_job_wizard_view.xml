<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pause_job_wizard_form" model="ir.ui.view">
        <field name="name">pause.job.wizard.form</field>
        <field name="model">pause.job.wizard</field>
        <field name="arch" type="xml">
            <form string="Pause Job">
                <sheet>
                    <field name="status_log_id" invisible="1"/>
                    <div class="alert alert-warning d-flex align-items-center mb-3 p-3 rounded">
                        <i class="fa fa-pause-circle fa-2x me-3 text-warning"/>
                        <div>
                            <strong>Pause Active Work</strong>
                            <div class="text-muted small">Please select the reason for pausing this job. Active timers will be automatically paused.</div>
                        </div>
                    </div>
                    <group>
                        <field name="pause_reason" widget="radio" string="Pause Reason" options="{'horizontal': false}"/>
                    </group>
                    <group>
                        <field name="notes" string="Notes / Reason Details" placeholder="Optional: specify missing parts, customer approval details, or tools needed..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_pause" string="Confirm Pause" type="object" class="btn-warning text-dark fw-bold" icon="fa-pause"/>
                    <button name="action_cancel" string="Cancel (Resume Work)" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
